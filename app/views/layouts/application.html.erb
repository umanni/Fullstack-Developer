<!DOCTYPE html>
<html>
  <head>
    <title data-inertia><%= content_for(:title) || "Fullstack Developer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fullstack Developer">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "inertia.jsx" %>
    <%= inertia_ssr_head %>
  </head>

  <body>
    <header class="border-b">
      <nav class="container mx-auto px-5 py-3 flex items-center gap-4 text-sm">
        <%= link_to "Home", root_path, class: "font-bold" %>
        <% if authenticated? %>
          <% if Current.user&.admin? %>
            <%= link_to "Dashboard", admin_root_path %>
            <%= link_to "Users", admin_users_path %>
            <%= link_to "Imports", admin_user_imports_path %>
          <% else %>
            <%= link_to "Profile", profile_path %>
          <% end %>
          <%= button_to "Sign out", session_path, method: :delete, class: "ml-auto underline" %>
        <% else %>
          <%= link_to "Sign in", new_session_path, class: "ml-auto" %>
          <%= link_to "Sign up", new_registration_path, class: "rounded bg-blue-600 text-white px-3 py-1" %>
        <% end %>
      </nav>
    </header>
    <main class="container mx-auto mt-10 px-5">
      <% if notice = flash[:notice] %>
        <p class="bg-green-50 text-green-700 px-3 py-2 rounded mb-4" id="notice"><%= notice %></p>
      <% end %>
      <% if alert = flash[:alert] %>
        <p class="bg-red-50 text-red-500 px-3 py-2 rounded mb-4" id="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
