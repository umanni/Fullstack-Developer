<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Fullstack Developer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

  
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light">
  
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">
        <%= link_to "Isaías Altoé - Case", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto align-items-center">
            <% if user_signed_in? %>
              <li class="nav-item me-3">
                <% if current_user.avatar_image.attached? %>
                  <%= image_tag current_user.avatar_image, class: "rounded-circle", style: "width:35px; height:35px; object-fit:cover;" %>
                <% else %>
                  <%= image_tag "default-avatar.png", class: "rounded-circle", style: "width:35px; height:35px; object-fit:cover;" %>
                <% end %>
              </li>
              <li class="nav-item me-3">
                <span class="navbar-text text-white fw-semibold"><%= current_user.username %></span>
              </li>
            <% else %>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="pt-4">
      <%= yield %>
    </main>

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
