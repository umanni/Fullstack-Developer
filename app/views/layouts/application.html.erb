<!DOCTYPE html>
<html>
  <head>
    <title>Umanni App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar" role="navigation" aria-label="main navigation">
      <div class="navbar-brand">
        <%= link_to "Umanni", root_path, class: "navbar-item has-text-weight-bold is-size-5" %>

        <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasic">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </a>
      </div>

      <div id="navbarBasic" class="navbar-menu">
        <div class="navbar-start">
          <% if user_signed_in? && current_user.admin? %>
            <%= link_to "Dashboard Admin", admin_dashboard_path, class: "navbar-item" %>
            <%= link_to "Usuários", admin_users_path, class: "navbar-item" %>
          <% elsif user_signed_in? %>
            <%= link_to "Dashboard", dashboard_index_path, class: "navbar-item" %>
          <% end %>
        </div>

        <div class="navbar-end">
          <% if user_signed_in? %>
            <%= link_to "Perfil", profile_path, class: "navbar-item" %>
            <%= button_to "Sair", destroy_user_session_path,
                  method: :delete,
                  class: "navbar-item button is-danger is-light",
                  form_class: "navbar-item" %>
          <% else %>
            <%= link_to "Entrar", new_user_session_path, class: "navbar-item" %>
            <%= link_to "Cadastrar", new_user_registration_path, class: "navbar-item" %>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <section class="section">
      <div class="container">
        <% flash.each do |type, message| %>
          <% css_class =
              case type.to_sym
              when :notice then "notification is-success"
              when :alert then "notification is-danger"
              else "notification is-info"
              end %>

          <div class="<%= css_class %>">
            <button class="delete" data-dismiss="notification"></button>
            <%= message %>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Main content -->
    <main class="section">
      <div class="container">
        <%= yield %>
      </div>
    </main>

    <footer class="footer">
      <p>© <%= Time.current.year %> Umanni. All rights reserved.</p>
    </footer>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const burgers = Array.from(document.querySelectorAll(".navbar-burger"));
        burgers.forEach(burger => {
          burger.addEventListener("click", () => {
            const target = document.getElementById(burger.dataset.target);
            burger.classList.toggle("is-active");
            target.classList.toggle("is-active");
          });
        });
      });
    </script>
  </body>
</html>
