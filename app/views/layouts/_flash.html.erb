<% if notice.present? %>
  <div
    class="
      bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg
      relative mb-5
    "
    role="alert"
    data-controller="remove-element"
    data-remove-element-delay-value="3000"
  >
    <span class="block sm:inline"><%= notice %></span>
    <button
      data-action="click->remove-element#remove"
      class="absolute top-0 bottom-0 right-0 px-4 py-3"
    >
      &times;
    </button>
  </div>
<% end %>

<% if alert.present? %>
  <div
    class="
      bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative mb-5
    "
    role="alert"
    data-controller="remove-element"
    data-remove-element-delay-value="3000"
  >
    <span class="block sm:inline"><%= alert %></span>
    <button
      data-action="click->remove-element#remove"
      class="absolute top-0 bottom-0 right-0 px-4 py-3"
    >
      &times;
    </button>
  </div>
<% end %>
