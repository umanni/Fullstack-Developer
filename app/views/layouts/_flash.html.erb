<% if alert = flash[:alert] %>
  <div
    class="
      mb-5 inline-block rounded-md border border-red-200 bg-red-50 p-4
      shadow-sm
    "
    id="alert"
  >
    <div class="flex">
      <div class="flex-shrink-0">
        <svg
          class="h-5 w-5 text-red-400"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z"
            clip-rule="evenodd"
          />
        </svg>
      </div>

      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800"><%= alert %></h3>
      </div>
    </div>
  </div>
<% end %>

<% if notice = flash[:notice] %>
  <div
    class="
      mb-5 inline-block rounded-md border border-emerald-200 bg-emerald-50
      p-4 shadow-sm
    "
    id="notice"
  >
    <div class="flex">
      <div class="flex-shrink-0">
        <svg
          class="h-5 w-5 text-emerald-400"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
            clip-rule="evenodd"
          />
        </svg>
      </div>

      <div class="ml-3">
        <h3 class="text-sm font-medium text-emerald-800"><%= notice %></h3>
      </div>
    </div>
  </div>
<% end %>
