<div data-controller="sidebar-toggle">
  <!-- Mobile Header / Hamburger -->
  <div
    class="
      fixed top-0 left-0 z-30 flex w-full items-center justify-between
      border-b border-gray-200 bg-white p-4 shadow-sm md:hidden
    "
  >
    <div class="text-lg font-bold tracking-tight text-gray-900">
      Fullstack Developer
    </div>

    <button
      data-action="sidebar-toggle#toggle"
      title="Menu"
      aria-label="Menu"
      class="
        rounded-md p-1 text-gray-600 transition-colors hover:bg-gray-100
        hover:text-gray-900 focus:outline-none
      "
    >
      <svg
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Sidebar -->
  <aside
    data-sidebar-toggle-target="menu"
    class="
      fixed inset-y-0 left-0 z-40 flex h-screen w-64 -translate-x-full
      transform flex-col border-r border-gray-200 bg-white
      transition-transform duration-300 ease-in-out md:translate-x-0
    "
  >
    <div
      class="
        hidden h-16 items-center justify-center border-b border-gray-100 p-4
        md:flex
      "
    >
      <span class="text-lg font-bold tracking-tight text-gray-900">Fullstack Developer</span>
    </div>

    <!-- User Profile area -->
    <div class="mt-14 flex flex-col items-center p-6 md:mt-0">
      <% if Current.user.avatar.attached? %>
        <%= image_tag Current.user.avatar.variant(resize_to_limit: [ 96, 96 ]), alt: Current.user.full_name, class: "size-20 rounded-full object-cover shadow-sm border border-gray-100 mb-3" %>
      <% else %>
        <div
          class="
            mb-3 flex size-20 items-center justify-center rounded-full
            border border-gray-200 bg-gray-100
          "
        >
          <svg
            class="h-10 w-10 text-gray-400"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </div>
      <% end %>

      <div class="w-full text-center">
        <p class="truncate px-2 text-sm font-semibold text-gray-900">
          <%= Current.user.full_name %>
        </p>

        <p class="mt-1 text-xs font-bold tracking-wider text-emerald-600 uppercase">
          <%= Current.user.role == 'admin' ? 'Administrador' : 'Usuário Normal' %>
        </p>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 space-y-1 overflow-y-auto px-4 py-2">
      <%= link_to "Meu Perfil", profile_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md #{current_page?(profile_path) || current_page?(edit_profile_path) ? 'bg-emerald-50 text-emerald-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} transition-colors" %>

      <% if Current.user.admin? %>
        <div class="pt-6 pb-2">
          <p class="px-3 text-xs font-bold tracking-wider text-gray-400 uppercase">
            Admin
          </p>
        </div>
        <%= link_to "Painel", admin_dashboard_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_dashboard_path) ? 'bg-emerald-50 text-emerald-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} transition-colors" %>
        <%= link_to "Usuários", admin_users_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_users_path) ? 'bg-emerald-50 text-emerald-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} transition-colors" %>
        <%= link_to "Importações de Planilha", admin_spreadsheet_imports_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md #{current_page?(admin_spreadsheet_imports_path) ? 'bg-emerald-50 text-emerald-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'} transition-colors" %>
      <% end %>
    </nav>

    <!-- Logout -->
    <div class="border-t border-gray-100 p-4">
      <%= button_to "Sair", session_path, method: :delete, class: "w-full flex items-center justify-center gap-2 px-4 py-2 text-sm font-semibold text-gray-600 hover:text-red-600 hover:bg-red-50 rounded-md transition-colors" %>
    </div>
  </aside>

  <!-- Overlay for mobile -->
  <div
    data-sidebar-toggle-target="overlay"
    data-action="click->sidebar-toggle#close"
    class="
      fixed inset-0 z-30 hidden bg-gray-900/50 backdrop-blur-sm
      transition-opacity md:hidden
    "
  ></div>
</div>
