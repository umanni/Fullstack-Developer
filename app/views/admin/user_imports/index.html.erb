<div class="mx-auto max-w-2xl py-8">
  <h1 class="font-bold text-2xl mb-4">Imports</h1>
  <%= link_to "New import", new_admin_user_import_path, class: "bg-blue-600 text-white rounded px-3 py-2" %>
  <ul>
    <% @imports.each do |imp| %>
      <li><%= link_to "Import #{imp.id} - #{imp.status}", admin_user_import_path(imp) %></li>
    <% end %>
  </ul>
</div>
