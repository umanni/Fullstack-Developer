<div>

  <%= turbo_stream_from @user_import %>

  <h1 class="title-h1">Import Progress</h1>

  <div class="max-w-2xl bg-white p-6 shadow-md rounded-lg">
    <%= turbo_frame_tag "user_import_status" do %>
      <h3 class="title-h3">
        Status:
        <span class="px-3 py-1 text-sm font-medium text-white bg-blue-600 rounded-full">
          <%= @user_import.status&.humanize %>
        </span>
      </h3>
    <% end %>

    <%= turbo_frame_tag "import_progress_bar" do %>
      <%= render "progress", import: @user_import %>
    <% end %>

    <h4 class="text-lg font-semibold mt-8 mb-2">Error Log:</h4>
    <pre class="bg-gray-100 p-4 rounded-md overflow-x-auto text-sm text-red-700">
      <%= @user_import.error_log.presence || "No errors." %>
    </pre>
  </div>
</div>
