<div class="users-header mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="mb-1">Users</h1>
      <p class="text-muted mb-0">
        <span class="badge bg-primary"><%= @users&.count || 0 %></span> total users
      </p>
    </div>
    <%= link_to new_admin_user_path, class: 'btn btn-primary btn-lg' do %>
      <i class="bi bi-plus-circle me-2"></i>New User
    <% end %>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 users-table">
        <thead class="table-light">
          <tr>
            <th style="width: 80px;" class="text-center">Avatar</th>
            <th>Full Name</th>
            <th>Email</th>
            <th style="width: 100px;" class="text-center">Role</th>
            <th style="width: 130px;" class="text-center">Created At</th>
            <th style="width: 200px;" class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @users.present? %>
            <% @users.each do |user| %>
              <tr class="user-row">
                <td class="text-center">
                  <div class="avatar-wrapper">
                    <%= avatar_image_tag(user, class: 'avatar-medium') %>
                  </div>
                </td>
                <td>
                  <div class="fw-semibold"><%= user.full_name %></div>
                </td>
                <td>
                  <div class="text-muted small"><%= user.email %></div>
                </td>
                <td class="text-center">
                  <span class="badge <%= user.admin? ? 'bg-danger' : 'bg-secondary' %> role-badge">
                    <%= user.role.capitalize %>
                  </span>
                </td>
                <td class="text-center">
                  <span class="text-muted small">
                    <%= user.created_at.strftime('%b %d, %Y') %>
                  </span>
                </td>
                <td class="text-center">
                  <div class="btn-group btn-group-sm" role="group">
                    <%= link_to edit_admin_user_path(user), 
                        class: 'btn btn-outline-primary', 
                        title: 'Edit user' do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= link_to toggle_role_admin_user_path(user), 
                        method: :patch,
                        class: 'btn btn-outline-warning',
                        title: 'Toggle role' do %>
                      <i class="bi bi-arrow-repeat"></i>
                    <% end %>
                    <%= form_with url: admin_user_path(user), method: :delete, local: true, style: 'display: inline;', data: { turbo: false } do |form| %>
                      <%= form.button type: 'submit', 
                          class: 'btn btn-outline-danger',
                          title: 'Delete user',
                          data: { confirm: 'Are you sure you want to delete this user?' } do %>
                        <i class="bi bi-trash"></i>
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
                <p class="mt-3 mb-0">No users found</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

