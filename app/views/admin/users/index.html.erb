<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Usuários</h1>
    <%= link_to "Novo usuário", new_admin_user_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <table class="w-full mt-5 text-left">
    <thead>
      <tr>
        <th class="pb-2">Nome</th>
        <th class="pb-2">E-mail</th>
        <th class="pb-2">Perfil</th>
        <th class="pb-2"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="border-t border-gray-200">
          <td class="py-3">
            <div class="flex items-center gap-2">
              <%= render "shared/avatar", user: user %>
              <%= link_to user.full_name, admin_user_path(user) %>
            </div>
          </td>
          <td class="py-3"><%= user.email %></td>
          <td class="py-3"><%= user.user_role.label %></td>
          <td class="py-3 text-right whitespace-nowrap">
            <%= link_to "Editar", edit_admin_user_path(user) %>
            |
            <%= button_to "Alternar perfil", toggle_role_admin_user_path(user), method: :patch, class: "inline underline cursor-pointer bg-transparent border-0 p-0" %>
            |
            <%= button_to "Excluir", admin_user_path(user), method: :delete, form: { data: { turbo_confirm: "Tem certeza?" }, class: "inline" }, class: "inline underline cursor-pointer bg-transparent border-0 p-0 text-red-600" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
