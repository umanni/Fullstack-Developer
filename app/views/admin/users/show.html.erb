<div class="w-full">
  <h1 class="font-bold text-4xl"><%= @user.full_name %></h1>

  <div class="my-5 flex gap-4 items-start">
    <%= render "shared/avatar", user: @user %>
    <div>
      <p><strong>E-mail:</strong> <%= @user.email %></p>
      <p><strong>Perfil:</strong> <%= @user.user_role.label %></p>
    </div>
  </div>

  <div class="flex gap-2">
    <%= link_to "Editar", edit_admin_user_path(@user), class: "rounded-lg py-3 px-5 bg-gray-100 font-medium" %>
    <%= button_to "Alternar perfil", toggle_role_admin_user_path(@user), method: :patch, class: "rounded-lg py-3 px-5 bg-gray-100 font-medium cursor-pointer" %>
    <%= link_to "Voltar aos usuários", admin_users_path, class: "rounded-lg py-3 px-5 bg-gray-100 font-medium" %>
  </div>
</div>
