<div class="card shadow-sm p-4 mt-4" style="max-width: 600px; margin: 0 auto;">
  <h2 class="mb-3 text-primary text-center fw-semibold">Import Users</h2>
  <p class="text-muted text-center mb-4">
    Upload a <strong>CSV</strong> or <strong>XLSX</strong> file containing user data to import them into the system.
  </p>
  <p class="text-muted text-center mb-2">
    Expected columns in the first row: <code>username</code>, <code>password</code>, <code>email</code>.
  </p>

  <%= form_with url: import_admin_users_path, local: true, html: { multipart: true, class: "needs-validation" } do |f| %>
    <div class="mb-3">
      <%= f.label :file, "Select file", class: "form-label fw-medium" %>
      <%= f.file_field :file, class: "form-control", required: true %>
      <div class="form-text">
        Accepted formats: <code>.csv</code>, <code>.xlsx</code>
      </div>
    </div>

    <div class="d-grid mt-4">
      <%= f.submit "Import Users", class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>

<div class="text-center mt-3">
  <%= link_to "← Back to User List", admin_users_path, class: "text-decoration-none text-secondary" %>
</div>
