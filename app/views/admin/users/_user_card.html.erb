<article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" data-testid="user-row">
  <div class="flex items-center gap-3">
    <%= render "shared/avatar", user:, size: "size-12" %>
    <div class="min-w-0">
      <h2 class="truncate font-semibold"><%= user.full_name %></h2>
      <p class="truncate text-xs text-slate-500"><%= user.email %></p>
    </div>
    <span class="ml-auto rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold"><%= user.role %></span>
  </div>
  <div class="mt-4 border-t border-slate-100 pt-3">
    <%= render "actions", user:, mobile: true %>
  </div>
</article>
