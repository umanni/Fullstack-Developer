<div class="mx-auto max-w-xl py-8">
  <h1 class="font-bold text-2xl mb-4">New user</h1>
  <%= form_with model: [:admin, @user], class: "contents" do |f| %>
    <%= f.text_field :full_name, placeholder: "Full name", required: true, class: "block w-full border rounded px-3 py-2 my-2" %>
    <%= f.email_field :email, placeholder: "Email", required: true, class: "block w-full border rounded px-3 py-2 my-2" %>
    <%= f.password_field :password, placeholder: "Password", required: true, class: "block w-full border rounded px-3 py-2 my-2" %>
    <%= f.password_field :password_confirmation, placeholder: "Confirm", required: true, class: "block w-full border rounded px-3 py-2 my-2" %>
    <%= f.select :role, User.roles.keys, {}, class: "block w-full border rounded px-3 py-2 my-2" %>
    <%= f.submit class: "bg-blue-600 text-white rounded px-3 py-2" %>
  <% end %>
</div>
