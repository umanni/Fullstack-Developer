<li id="<%= dom_id(import) %>" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm list-none">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= import_status_class(import.status) %>"><%= import.status %></span>
        <span class="text-sm text-slate-500">#<%= import.id %></span>
      </div>
      <p class="mt-2 text-sm text-slate-700">
        <%= import.successful_rows %>/<%= import.total_rows %> succeeded
        <% if import.failed_rows.positive? %>
          · <%= import.failed_rows %> failed
        <% end %>
      </p>
      <% if import.error_message.present? %>
        <p class="mt-1 text-xs text-rose-700"><%= truncate(import.error_message, length: 140) %></p>
      <% end %>
    </div>
    <div class="text-right text-xs text-slate-500">
      <p><%= time_ago_in_words(import.created_at) %> ago</p>
      <%= link_to "Details", admin_import_path(import), class: "mt-1 inline-block font-semibold text-teal-800 hover:underline" %>
    </div>
  </div>

  <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100" role="progressbar" aria-valuenow="<%= import.progress_percent %>" aria-valuemin="0" aria-valuemax="100">
    <div class="h-full rounded-full bg-teal-600 transition-all duration-300" style="width: <%= import.progress_percent %>%"></div>
  </div>
</li>
