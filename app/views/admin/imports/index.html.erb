<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Importações</h1>
    <%= link_to "Nova importação", new_admin_import_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <% if @imports.any? %>
    <table class="w-full mt-5 text-left">
      <thead>
        <tr>
          <th class="pb-2">Arquivo</th>
          <th class="pb-2">Status</th>
          <th class="pb-2">Sucesso</th>
          <th class="pb-2">Falhas</th>
          <th class="pb-2">Progresso</th>
        </tr>
      </thead>
      <tbody>
        <% @imports.each do |import| %>
          <tr class="border-t border-gray-200">
            <td class="py-2"><%= link_to import.filename, admin_import_path(import) %></td>
            <td class="py-2"><%= import_status_label(import.status) %></td>
            <td class="py-2"><%= import.success_count %></td>
            <td class="py-2"><%= import.failure_count %></td>
            <td class="py-2"><%= import.progress_percent %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="mt-5">Nenhuma importação ainda.</p>
  <% end %>
</div>
