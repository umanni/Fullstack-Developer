<% content_for :title, "Import" %>

<%= turbo_stream_from @spreadsheet_import %>

<div class="mx-auto w-full max-w-3xl">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight">Import</h1>
      <p class="mt-1 text-sm text-slate-500">
        Started <%= time_ago_in_words(@spreadsheet_import.created_at) %> ago by
        <%= @spreadsheet_import.user.full_name %>.
      </p>
    </div>

    <div class="flex gap-2">
      <%= link_to "All imports", admin_spreadsheet_imports_path, class: "btn-secondary" %>
      <%= link_to "New import", new_admin_spreadsheet_import_path, class: "btn-primary" %>
    </div>
  </div>

  <div class="mt-6">
    <%= render "progress", spreadsheet_import: @spreadsheet_import %>
  </div>

</div>
