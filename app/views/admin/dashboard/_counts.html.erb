<div id="dashboard-counts">
  <div class="grid grid-cols-2 gap-4">
    <div class="rounded-lg border p-4">
      <p class="text-sm text-gray-500">Total number of Users</p>
      <p class="text-3xl font-bold"><%= total_users %></p>
    </div>
    <div class="rounded-lg border p-4">
      <p class="text-sm text-gray-500">By Role</p>
      <ul>
        <% users_by_role.each do |role, count| %>
          <li><%= role %>: <%= count %></li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
