<div id="dashboard_stats" class="grid gap-4 sm:grid-cols-3">
  <article class="rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total users</p>
    <p class="mt-3 font-[family-name:var(--font-display)] text-4xl text-slate-900" data-testid="total-users"><%= stats.total %></p>
  </article>
  <article class="rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Admins</p>
    <p class="mt-3 font-[family-name:var(--font-display)] text-4xl text-teal-800" data-testid="admin-users"><%= stats.admins %></p>
  </article>
  <article class="rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Members</p>
    <p class="mt-3 font-[family-name:var(--font-display)] text-4xl text-slate-800" data-testid="member-users"><%= stats.members %></p>
  </article>
</div>
