<div id="dashboard_stats" class="grid gap-4 sm:grid-cols-3" aria-live="polite">
  <% [ [ "Total users", stats.total, "from-indigo-500 to-violet-600" ], [ "Administrators", stats.admins, "from-amber-500 to-orange-600" ], [ "Standard users", stats.users, "from-emerald-500 to-teal-600" ] ].each do |label, value, gradient| %>
    <article class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <span class="absolute right-4 top-4 size-10 rounded-xl bg-gradient-to-br <%= gradient %> opacity-15"></span>
      <p class="text-sm font-medium text-slate-500"><%= label %></p>
      <p class="mt-2 text-4xl font-black tracking-tight text-slate-950"><%= value %></p>
      <p class="mt-2 text-xs text-slate-400">Updated in real time</p>
    </article>
  <% end %>
</div>
