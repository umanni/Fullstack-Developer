<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <%# Total Users Card %>
  <div class="bg-white shadow-md rounded-lg p-6">
    <h5 class="text-lg font-medium text-gray-500 mb-2">Total Users</h5>
    <p class="text-5xl font-bold text-gray-800"><%= total_users %></p>
  </div>

  <%# Users by Role Card %>
  <div class="bg-white shadow-md rounded-lg p-6">
    <h5 class="title-h5">Users by Role</h5>
    <ul class="divide-y divide-gray-200">
      <li class="list-item">
        <span class="text-gray-700">Admins</span>
        <span class="px-3 py-1 text-sm font-medium text-white bg-blue-600 rounded-full">
          <%= users_by_role["admin"] || 0 %>
        </span>
      </li>
      <li class="list-item">
        <span class="text-gray-700">Users</span>
        <span class="px-3 py-1 text-sm font-medium text-white bg-gray-500 rounded-full">
          <%= users_by_role["user"] || 0 %>
        </span>
      </li>
    </ul>
  </div>
</div>
