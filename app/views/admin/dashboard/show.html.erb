<%= turbo_stream_from "admin-dashboard" %>
<div class="mx-auto max-w-3xl w-full py-8">
  <h1 class="font-bold text-3xl mb-6">User Admin Dashboard</h1>

  <div class="mb-4 flex gap-3 text-sm">
    <%= link_to "Users", admin_users_path, class: "underline" %>
    <%= link_to "Imports", admin_user_imports_path, class: "underline" %>
  </div>

  <%= render "counts", total_users: @total_users, users_by_role: @users_by_role %>
</div>
