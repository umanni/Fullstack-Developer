<div class="flex items-center gap-3 px-2 py-1.5">
  <span class="avatar h-9 w-9 text-xs" aria-hidden="true"><%= user_initials(Current.user) %></span>

  <div class="min-w-0 flex-1">
    <p class="truncate text-sm font-medium text-ink"><%= Current.user.full_name %></p>
    <p class="truncate text-xs text-muted"><%= Current.user.role.humanize %></p>
  </div>

  <%= button_to "Sign out", session_path, method: :delete,
        class: "btn btn-ghost px-2 py-1 text-xs",
        form: { data: { turbo_confirm: "Sign out of Roster?" } } %>
</div>
