<% page_title "Register" %>

<section class="mx-auto max-w-2xl">
  <div class="rounded-3xl border border-slate-200 bg-white/90 p-8 shadow-sm">
    <h1 class="font-[family-name:var(--font-display)] text-3xl text-slate-900">Create your account</h1>
    <p class="mt-2 text-sm text-slate-600">Visitors register as normal members.</p>
    <div class="mt-6">
      <%= render "shared/user_form",
            user: @user,
            url: registration_path,
            method: :post,
            submit_label: "Register",
            cancel_path: root_path %>
    </div>
  </div>
</section>
