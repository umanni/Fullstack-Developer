<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Recuperar senha</h1>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :email, "E-mail" %>
      <%= form.email_field :email, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <%= form.submit "Enviar instruções", class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
  <% end %>

  <div class="mt-4">
    <%= link_to "Voltar para o login", new_session_path %>
  </div>
</div>
