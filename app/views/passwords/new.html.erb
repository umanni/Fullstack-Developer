<% content_for :title, t(".title") %>

<div class="panel p-7">
  <h2 class="text-xl font-semibold tracking-tight text-ink"><%= t(".title") %></h2>
  <p class="mt-1 text-sm text-muted"><%= t(".subtitle") %></p>

  <%= form_with url: passwords_path, class: "mt-6" do |form| %>
    <div class="field">
      <%= form.label :email_address, t(".email_address"), class: "field-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address], class: "field-input" %>
    </div>

    <%= form.submit t(".submit"), class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-6 border-t border-line pt-5 text-sm text-muted">
    <%= t(".remembered") %>
    <%= link_to t(".sign_in"), new_session_path, class: "text-accent-strong hover:underline" %>
  </p>
</div>
