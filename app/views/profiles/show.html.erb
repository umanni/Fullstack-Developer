<% page_title "My profile" %>

<section class="mx-auto max-w-3xl space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-4">
      <%= avatar_tag @user, size: 72 %>
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-3xl text-slate-900"><%= @user.full_name %></h1>
        <p class="text-slate-600"><%= @user.email_address %></p>
        <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= role_badge_class(@user.role) %>"><%= @user.role %></span>
      </div>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit profile", edit_profile_path, class: "rounded-xl bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800" %>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white/90 p-6 shadow-sm">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Account details</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs text-slate-500">Full name</dt>
        <dd class="mt-1 font-medium"><%= @user.full_name %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Email</dt>
        <dd class="mt-1 font-medium"><%= @user.email_address %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Role</dt>
        <dd class="mt-1 font-medium"><%= @user.role %></dd>
      </div>
      <div>
        <dt class="text-xs text-slate-500">Member since</dt>
        <dd class="mt-1 font-medium"><%= l @user.created_at.to_date, format: :long %></dd>
      </div>
    </dl>
  </div>
</section>
