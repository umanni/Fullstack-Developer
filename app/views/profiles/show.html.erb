<div class="row">
  <div class="col-md-8 mx-auto">
    <div class="card">
      <div class="card-header">
        <h4 class="mb-0">My Profile</h4>
      </div>
      <div class="card-body">
        <div class="text-center mb-4">
          <%= image_tag @user.display_avatar, class: 'avatar-preview' %>
        </div>
        <table class="table">
          <tr>
            <th>Full Name:</th>
            <td><%= @user.full_name %></td>
          </tr>
          <tr>
            <th>Email:</th>
            <td><%= @user.email %></td>
          </tr>
          <tr>
            <th>Role:</th>
            <td>
              <span class="badge <%= @user.admin? ? 'bg-danger' : 'bg-secondary' %>">
                <%= @user.role.capitalize %>
              </span>
            </td>
          </tr>
          <tr>
            <th>Member Since:</th>
            <td><%= @user.created_at.strftime('%B %d, %Y') %></td>
          </tr>
        </table>
        <div class="d-flex gap-2 justify-content-end">
          <%= link_to 'Edit Profile', edit_profile_path, class: 'btn btn-primary' %>
          <%= link_to 'Delete Account', profile_path, method: :delete, 
              confirm: 'Are you sure you want to delete your account? This action cannot be undone.', 
              class: 'btn btn-danger' %>
        </div>
      </div>
    </div>
  </div>
</div>

