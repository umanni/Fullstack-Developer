<% content_for :title, "My profile" %>
<% content_for :page_title, "My profile" %>
<% content_for :page_subtitle, "Your account details" %>

<div class="panel p-6 sm:p-8">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
    <span class="avatar h-16 w-16 text-lg" aria-hidden="true"><%= user_initials(@user) %></span>

    <div class="min-w-0 flex-1">
      <h2 class="truncate text-xl font-semibold tracking-tight text-ink"><%= @user.full_name %></h2>
      <p class="truncate text-sm text-muted"><%= @user.email_address %></p>
      <div class="mt-2"><%= role_badge(@user) %></div>
    </div>

    <%= link_to "Edit profile", edit_profile_path, class: "btn btn-ghost" %>
  </div>

  <dl class="mt-8 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
    <div class="bg-surface px-4 py-3">
      <dt class="eyebrow">Full name</dt>
      <dd class="mt-1 text-sm text-ink"><%= @user.full_name %></dd>
    </div>
    <div class="bg-surface px-4 py-3">
      <dt class="eyebrow">Email address</dt>
      <dd class="mt-1 text-sm text-ink"><%= @user.email_address %></dd>
    </div>
    <div class="bg-surface px-4 py-3">
      <dt class="eyebrow">Role</dt>
      <dd class="mt-1 text-sm text-ink"><%= @user.role.humanize %></dd>
    </div>
    <div class="bg-surface px-4 py-3">
      <dt class="eyebrow">Member since</dt>
      <dd class="mt-1 text-sm text-ink"><%= l(@user.created_at.to_date, format: :long) %></dd>
    </div>
  </dl>
</div>

<div class="panel-quiet mt-6 flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <p class="text-sm font-medium text-ink">Delete this account</p>
    <p class="text-xs text-muted">Your profile and sessions are removed. This cannot be undone.</p>
  </div>

  <%= button_to "Delete my account", profile_path, method: :delete,
        class: "btn btn-danger",
        form: { data: { turbo_confirm: "Delete your account? This cannot be undone." } } %>
</div>
