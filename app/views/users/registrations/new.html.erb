<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { controller: "form-validation", action: "input->form-validation#validate submit->form-validation#onSubmit" } }) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, data: { form_validation_target: "input" } %>
    <div data-form-validation-error-for="user[email]" class="error-message" style="display:none"></div>
  </div>

  <div class="field">
    <%= f.label :password %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password", required: true, data: { form_validation_target: "input", minlength: (@minimum_password_length || 8) } %>
    <div data-form-validation-error-for="user[password]" class="error-message" style="display:none"></div>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, data: { form_validation_target: "input" } %>
    <div data-form-validation-error-for="user[password_confirmation]" class="error-message" style="display:none"></div>
  </div>

  <div class="actions">
    <%= f.submit "Sign up" %>
  </div>
<% end %>

<%= render "users/shared/links" %>
