<div class="d-flex flex-column align-items-center mt-5">
  <h2><%= t("devise.sign_in.title") %></h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="d-grid gap-3 mb-3">
      <div class="field">
        <%= f.label :email, class: "form-lable" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
      </div>

      <div class="field">
        <%= f.label :password, class: "form-lable" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control", required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field form-check">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, class: "form-check-label" %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit t("devise.sign_in.submit"), class: "btn btn-primary w-100" %>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
