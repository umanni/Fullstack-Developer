#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # Validate required environment variables
  if [ -z "$RAILS_MASTER_KEY" ]; then
    echo "ERROR: RAILS_MASTER_KEY is not set. Export it before running docker compose:"
    echo "  export RAILS_MASTER_KEY=\"\$(cat config/master.key)\""
    exit 1
  fi
  if [ -z "$SECRET_KEY_BASE" ]; then
    echo "ERROR: SECRET_KEY_BASE is not set. Export it before running docker compose:"
    echo "  export SECRET_KEY_BASE=\"\$(openssl rand -hex 64)\""
    exit 1
  fi

  ./bin/rails db:prepare

  # Create Solid Cache/Queue/Cable databases if they don't exist
  # These are separate PostgreSQL databases used by Rails 8 Solid adapters.
  # Connect to the primary development database to issue CREATE DATABASE commands.
  PRIMARY_DB="fullstack_developer_development"
  for DB_NAME in fullstack_developer_cache fullstack_developer_queue fullstack_developer_cable; do
    PGPASSWORD="${FULLSTACK_DEVELOPER_DATABASE_PASSWORD:-fullstack_developer}" \
      psql -h db -U fullstack_developer -d "$PRIMARY_DB" -tc "SELECT 1 FROM pg_database WHERE datname = '${DB_NAME}'" \
      | grep -q 1 || \
      PGPASSWORD="${FULLSTACK_DEVELOPER_DATABASE_PASSWORD:-fullstack_developer}" \
        psql -h db -U fullstack_developer -d "$PRIMARY_DB" -c "CREATE DATABASE ${DB_NAME}"
  done
fi

exec "${@}"
